# Elice ML API (OpenAI-compatible serverless)
# 엘리스는 모델(엔드포인트)마다 base_url이 다르므로 역할별로 지정한다.
# base_url 형식: https://mlapi.run/{endpoint-id}/v1  (모델 상세 > API 탭에서 확인)
ELICE_API_KEY=

# 생성(답변) 모델
LLM_MODEL=gpt-5.6-sol
LLM_BASE_URL=https://mlapi.run/531a1cc4-645e-46ed-8feb-6fb43bbd965d/v1

# 임베딩 모델 (1536차원 — OpenAI text-embedding-3-small 프록시)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://mlapi.run/b54ff33e-6d14-42df-93f9-0f1132160ee8/v1

# Judge(평가) 모델 — 생성과 다른 계열 (self-preference 완화)
JUDGE_MODEL=gemini-3.1-pro-preview
JUDGE_BASE_URL=https://mlapi.run/62e68635-5e4c-4490-a5d4-59528aec05d2/v1

# (선택) reranker 전용 모델 — 미지정 시 LLM_MODEL/LLM_BASE_URL 사용
# RERANK_MODEL=
# RERANK_BASE_URL=

# temperature를 지원하지 않는 reasoning 모델(쉼표 구분). gpt-5.6-sol은 temperature=0을 거부한다.
NO_TEMPERATURE_MODELS=gpt-5.6-sol

DATABASE_URL=postgres://rag:rag@localhost:5432/rag

PORT=3000
