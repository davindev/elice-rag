# Elice ML API (OpenAI-compatible serverless endpoint)
# Base URL 형식: https://mlapi.run/{endpoint-id}/v1
ELICE_API_KEY=
ELICE_BASE_URL=

# 모델명은 엘리스 모델 라이브러리에서 확인한 값 사용
LLM_MODEL=
EMBEDDING_MODEL=
JUDGE_MODEL=
# (선택) reranker 전용 모델 — 미지정 시 LLM_MODEL 사용
# RERANK_MODEL=

DATABASE_URL=postgres://rag:rag@localhost:5432/rag

PORT=3000
